		{"id":"1663994cc6c3f74e","type":"text","text":"**CONSECUENCIAS DE LA RADIACIÓN EN LOS SERES VIVOS**","x":-2920,"y":-3600,"width":500,"height":59},
		{"id":"0a51ebea1652f4f6","type":"file","file":"TRAVNIK/Imágenes/PERSONAJES/SKINS/PALAPTICA PILOTO.jpg","x":-3092,"y":-269,"width":669,"height":382},
		{"id":"578e1b95e01141c2","type":"text","text":"QUASAR → [Quasar ](https://es.wikipedia.org/wiki/Cu%C3%A1sar)","x":-1814,"y":-1979,"width":250,"height":60,"color":"1"},
		{"id":"625fa69855d7d9a8","type":"file","file":"TRAVNIK/Imágenes/PERSONAJES/Mandril.jpg","x":-2329,"y":-1949,"width":267,"height":400,"color":"#000000"},
